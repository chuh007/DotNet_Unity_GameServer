.loading-screen {
    flex-grow: 1;
    background-color: var(--col-bg);
    align-items: center;
    justify-content: space-between;
    padding: 60px;
}

.loading-center {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.game-title {
    font-size: 110px;
    color: var(--col-accent);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(26, 16, 32);
    letter-spacing: 8px;
    white-space: nowrap;
}

.game-subtitle {
    font-size: 26px;
    color: var(--col-text-dim);
    margin-top: 18px;
    letter-spacing: 4px;
    white-space: nowrap;
}

.loading-bottom {
    width: 820px;
    align-items: center;
    margin-bottom: 30px;
}

.status-label {
    font-size: 22px;
    color: var(--col-text);
    margin-bottom: 14px;
}

.progress-track {
    width: 100%;
    height: 30px;
    background-color: var(--col-track);
    border-width: 3px;
    border-color: var(--col-border-light);
    padding: 3px;
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--col-success);
}

.version-label {
    position: absolute;
    right: 20px;
    bottom: 14px;
    font-size: 18px;
    color: var(--col-text-dim);
}
